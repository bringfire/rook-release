---
import rookRaven from '../assets/rook-raven.png';
import Corner from '../components/Corner.astro';
import '../styles/fonts.css';

const base = import.meta.env.BASE_URL; // "/rook-release/"
const href = (p) => `${base}${p}`.replace(/([^:]\/)\/+/g, '$1');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rook — Rhino 3D and Grasshopper, by conversation</title>
    <meta
      name="description"
      content="Rook is an AI collaborator inside Rhino & Grasshopper. Hand it the setup, organization, and busywork — and get on with designing."
    />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>

  <body>
    <!-- =============================== HERO =============================== -->
    <section class="hero paper frame">
      <Corner pos="tl" /><Corner pos="tr" /><Corner pos="bl" /><Corner pos="br" />

      <div class="meta-row">
        <span>Rook · AI for Rhino &amp; Grasshopper</span>
        <span class="hair"></span>
        <span>The Plugin</span>
      </div>

      <div class="hero-inner">
        <img class="raven" src={rookRaven.src} alt="Rook" width="300" />
        <p class="kicker">An AI collaborator inside Rhino &amp; Grasshopper</p>
        <h1 class="display">Rook</h1>
        <p class="subtitle">Rhino&nbsp;3D and Grasshopper, by&nbsp;conversation.</p>

        <div class="flourish">
          <span class="bar"></span>
          <span class="star">❧</span>
          <span class="bar"></span>
        </div>

        <p class="lede">
          Hand Rook the setup, the organization, and the busywork. You stay on the
          design.
        </p>

        <div class="actions">
          <a class="btn primary" href={href('start/what-is-rook/')}>Get started</a>
          <a class="btn ghost" href={href('start/install/')}>Download &amp; install</a>
        </div>
        <p class="sub-link">
          or view the project on
          <a href="https://github.com/bringfire/rook-release">GitHub</a>
        </p>
      </div>

      <div class="foot-row">
        <span>rook</span>
        <span>You design — Rook handles the rest</span>
      </div>
    </section>

    <!-- ========================= WHAT YOU HAND OFF ======================= -->
    <section class="strip paper">
      <div class="strip-inner">
        <p class="kicker center">What you hand off</p>
        <div class="flourish narrow">
          <span class="bar"></span><span class="star">✦</span><span class="bar"></span>
        </div>
        <div class="cards">
          <figure class="specimen">
            <figcaption class="hdr">Organize</figcaption>
            <p>“Sort my selection onto layers by type and name them sensibly.”</p>
          </figure>
          <figure class="specimen">
            <figcaption class="hdr">Clean up</figcaption>
            <p>“Find duplicate blocks and purge what isn't being used.”</p>
          </figure>
          <figure class="specimen">
            <figcaption class="hdr">Set out</figcaption>
            <p>“Lay out a 5&nbsp;×&nbsp;8 array so I can start designing.”</p>
          </figure>
        </div>
        <div class="actions center">
          <a class="btn primary" href={href('start/what-is-rook/')}>Get started</a>
        </div>
      </div>
    </section>

    <!-- ============================== FOOTER ============================= -->
    <footer class="foot paper">
      <span class="mark">Rook</span>
      <nav>
        <a href={href('start/what-is-rook/')}>What is Rook</a>
        <a href={href('start/install/')}>Install</a>
        <a href={href('modules/overview/')}>Modules</a>
        <a href={href('legal/privacy/')}>Privacy</a>
        <a href="https://github.com/bringfire/rook-release">GitHub</a>
      </nav>
    </footer>

    <style is:global>
      :root {
        --ink: #1a1410;
        --ink-soft: #3a2f26;
        --paper: #f0e7d2;
        --brass: #8a6a2c;
        --brass-deep: #5e4618;
        --oxblood: #702826;
        --line: #1a1410;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'EB Garamond', Georgia, serif; color: var(--ink); }

      /* Cream paper texture (from the deck .paper) */
      .paper {
        background:
          radial-gradient(ellipse at 30% 18%, rgba(255,250,230,0.55), transparent 60%),
          radial-gradient(ellipse at 82% 88%, rgba(138,106,44,0.10), transparent 65%),
          repeating-linear-gradient(100deg, rgba(26,20,16,0.018) 0 2px, transparent 2px 5px),
          repeating-linear-gradient(10deg, rgba(26,20,16,0.014) 0 1px, transparent 1px 7px),
          var(--paper);
      }

      /* ---- Hero: one elegant light screen ---- */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex; flex-direction: column; justify-content: center;
        padding: 96px clamp(28px, 8vw, 140px);
        overflow: hidden;
      }

      /* Double-rule frame */
      .frame::before, .frame::after { content: ""; position: absolute; border: 1px solid var(--line); pointer-events: none; }
      .frame::before { inset: 26px; }
      .frame::after { inset: 32px; opacity: 0.32; }

      /* Corner ornaments */
      .corner { position: absolute; width: 36px; height: 36px; color: var(--line); opacity: 0.85; }
      .corner.tl { top: 26px; left: 26px; }
      .corner.tr { top: 26px; right: 26px; transform: scaleX(-1); }
      .corner.bl { bottom: 26px; left: 26px; transform: scaleY(-1); }
      .corner.br { bottom: 26px; right: 26px; transform: scale(-1,-1); }

      /* Meta rows */
      .meta-row, .foot-row {
        position: absolute; left: clamp(44px, 9vw, 150px); right: clamp(44px, 9vw, 150px);
        display: flex; align-items: center; justify-content: space-between;
        font-family: 'JetBrains Mono', monospace; font-size: 12px;
        letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); opacity: 0.62;
      }
      .meta-row { top: 46px; }
      .foot-row { bottom: 46px; }
      .meta-row .hair { flex: 1; height: 1px; background: currentColor; opacity: 0.3; margin: 0 20px; }

      /* Hero content */
      .hero-inner { max-width: 880px; margin: 0 auto; text-align: center; }
      .raven { display: block; margin: 0 auto 6px; max-width: min(40vw, 300px); height: auto; mix-blend-mode: multiply; filter: contrast(1.08); }

      h1 { font-family: 'Cormorant Garamond', serif; font-weight: 500; margin: 0; }
      .display { font-size: clamp(58px, 11vw, 150px); line-height: 0.95; letter-spacing: -0.01em; }
      .subtitle { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 500; font-size: clamp(30px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.01em; margin: 6px 0 0; color: var(--ink); opacity: 0.92; }
      .kicker { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass-deep); margin: 0 0 16px; }
      .kicker.center { text-align: center; }
      .lede { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(22px, 2.8vw, 34px); line-height: 1.35; max-width: 620px; margin: 4px auto 0; }

      /* Flourish divider */
      .flourish { display: flex; align-items: center; gap: 18px; color: var(--brass-deep); opacity: 0.8; margin: 22px auto; max-width: 360px; }
      .flourish.narrow { max-width: 260px; }
      .flourish .bar { flex: 1; height: 1px; background: currentColor; opacity: 0.55; }
      .flourish .star { font-size: 22px; line-height: 1; }

      /* Buttons */
      .actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
      .actions.center { margin-top: 36px; }
      .btn {
        display: inline-flex; align-items: center; padding: 15px 30px;
        font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.14em;
        text-transform: uppercase; text-decoration: none; border-radius: 2px; border: 1px solid;
      }
      .btn.primary { background: var(--brass-deep); border-color: var(--brass-deep); color: var(--paper); }
      .btn.primary:hover { background: var(--oxblood); border-color: var(--oxblood); }
      .btn.ghost { background: transparent; border-color: var(--ink); color: var(--ink); opacity: 0.85; }
      .btn.ghost:hover { opacity: 1; }
      .sub-link { font-size: 17px; opacity: 0.7; margin-top: 18px; }
      .sub-link a { color: var(--brass-deep); }

      /* ---- Strip: what you hand off ---- */
      .strip { padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 140px); border-top: 1px solid rgba(26,20,16,0.18); }
      .strip-inner { max-width: 1040px; margin: 0 auto; }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 12px; }
      .specimen { margin: 0; border: 1px solid var(--line); border-radius: 2px; box-shadow: inset 0 0 0 3px var(--paper), inset 0 0 0 4px rgba(26,20,16,0.12); background: rgba(255,252,244,0.4); }
      .specimen .hdr { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brass-deep); padding: 13px 18px; border-bottom: 1px solid rgba(26,20,16,0.2); }
      .specimen p { margin: 0; padding: 20px 18px; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.3; }

      /* ---- Footer ---- */
      .foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding: 40px clamp(28px, 8vw, 140px); border-top: 1px solid rgba(26,20,16,0.18); }
      .foot .mark { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 600; }
      .foot nav { display: flex; gap: 26px; flex-wrap: wrap; }
      .foot nav a { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; color: var(--ink-soft); }
      .foot nav a:hover { color: var(--oxblood); }
    </style>
  </body>
</html>
